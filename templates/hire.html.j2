{% extends "_base.html.j2" %}

{# 구인 — 현장에 사람을 부르는 쪽.
   이 사람의 질문은 셋뿐이다: 언제까지 말하면 되나 / 어떤 사람을 보내나 / 얼마인가.
   비어 있는 값(마감시간·시세)은 섹션째 숨긴다. 모르는 걸 지어내면 그게 분쟁이 된다. #}

{% set d = region.hire %}

{% block seo_title %}{{ d.seo.title }}{% endblock %}
{% block seo_description %}{{ d.seo.description }}{% endblock %}
{% block seo_keywords %}{{ d.seo.keywords }}{% endblock %}
{% block og_title %}{{ d.seo.og_title }}{% endblock %}
{% block og_description %}{{ d.seo.og_description }}{% endblock %}

{% block content %}
<div class="topbar">
    <div class="container">
        <a href="{{ link('home') }}" class="brand">{{ region.name }}</a>
        <a href="{{ link('job') }}" class="home-link">일자리 찾으세요? →</a>
    </div>
</div>

<div class="page-head">
    <div class="container">
        <h1>{{ d.headline }}</h1>
        <p>{{ d.sub }}</p>
    </div>
</div>

<section>
    <div class="container">
        <a href="tel:{{ region.phones[0].number }}" class="call-cta">
            📞 인력 요청 {{ region.phones[0].number }}
            <small>현장 상황을 말씀해주시면 맞는 인력을 연결합니다</small>
        </a>

        {% if d.cutoff_note %}
        <p class="note"><strong>{{ d.cutoff_note }}</strong></p>
        {% endif %}

        <p class="note">
            커버 지역 — {{ region.cover_areas | join(' · ') }}
        </p>
    </div>
</section>

<section style="background:#f8f9fa;">
    <div class="container">
        <h2>보내드리는 인력</h2>
        <div class="service-grid">
            {% for s in region.services %}
            <div class="service-card">
                <div class="icon">{{ s.icon }}</div>
                <h3>{{ s.title }}</h3>
                <p>{{ s.desc }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<section>
    <div class="container">
        <h2>일당 안내</h2>
        {% if region.rates_verified %}
        <ul class="info-list">
            {% for r in region.rates_verified %}
            <li>
                <strong>{{ r.role }}</strong>
                {{ '{:,}'.format(r.low) }}원 ~ {{ '{:,}'.format(r.high) }}원
                {% if r.source %}<br><span style="color:#888;font-size:.9rem;">{{ r.source }}</span>{% endif %}
            </li>
            {% endfor %}
        </ul>
        <p class="note">
            현장 조건(층수·물량·작업 강도)에 따라 달라집니다. 정확한 금액은 상담 시 안내드립니다.
        </p>
        {% else %}
        <p class="note">
            일당은 직종과 현장 조건(층수·물량·작업 강도)에 따라 달라집니다.<br>
            전화 주시면 현장 이야기를 듣고 바로 알려드립니다.
        </p>
        {% endif %}
    </div>
</section>

{% if d.faq %}
<section style="background:#f8f9fa;">
    <div class="container">
        <h2>자주 묻는 질문</h2>
        <div class="faq">
            {% for item in d.faq %}
            <div class="faq-item">
                <div class="faq-q">Q. {{ item.q }}</div>
                <div class="faq-a">{{ item.a }}</div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

<section>
    <div class="container">
        <h2>온라인으로 요청하기</h2>
        <p style="text-align:center;margin-bottom:1.5rem;">
            전화가 어려우신가요? 아래 양식으로 남겨주시면 연락드립니다.
        </p>
        <a href="{{ region.apply_links.employer }}" class="call-cta" style="background:#1e3c72;box-shadow:0 5px 14px rgba(30,60,114,.35);" target="_blank">
            🏢 인력 요청서 작성하기
        </a>
        <p class="note">급하신 경우에는 전화가 가장 빠릅니다.</p>
    </div>
</section>
{% endblock %}
