{% extends "_base.html.j2" %}

{# 건설 직종 안내 — 현장에서 부르는 말로 찾는 페이지.

   왜 만드는가: 소장은 "야, 양중 곰빵 두 명!" 하고 툭 던지는데, 그 말을 처음 듣는
   사람(신규 직원·초보 구직자)은 무슨 일인지 모른다. 그 간격을 사이트가 메운다.
   그리고 "곰방 뜻"·"가다와꾸"·"하스리" 같은 말은 실제로 검색되는데 제대로 답하는
   곳이 거의 없다 — 이 페이지가 검색으로 사람을 데려오는 자리다.

   설명 원문은 data/roles.json. 지역마다 다르지 않아 지역 JSON에 두지 않았다. #}

{% set d = region.roles %}

{% block seo_title %}{{ d.seo.title }}{% endblock %}
{% block seo_description %}{{ d.seo.description }}{% endblock %}
{% block seo_keywords %}{{ d.seo.keywords }}{% endblock %}
{% block og_title %}{{ d.seo.og_title }}{% endblock %}
{% block og_description %}{{ d.seo.og_description }}{% endblock %}

{% block content %}
<div class="topbar">
    <div class="container">
        <a href="{{ link('home') }}" class="brand">{{ region.name }}</a>
        <a href="{{ link('hire') }}" class="home-link">인력 요청 →</a>
    </div>
</div>

<div class="page-head">
    <div class="container">
        <h1>{{ d.headline }}</h1>
        <p>{{ d.sub }}</p>
    </div>
</div>

<section>
    <div class="container">
        <p class="note">
            현장에서 쓰는 말과 정식 직종 이름이 달라 헷갈리는 경우가 많습니다.<br>
            아래에서 찾아보시고, 그래도 모르시겠으면 <strong>하시려는 일을 그대로 말씀해 주세요.</strong>
            듣고 맞는 인력을 연결해 드립니다.
        </p>

        {% for g in roles.groups %}
        <div class="role-group">
            <h2 class="role-group-name">{{ g.name }}</h2>
            {% for r in g.roles %}
            <div class="role-card">
                <h3 class="role-name">
                    {{ r.name }}
                    {% if r.alias and r.alias not in r.name %}<span class="role-alias">{{ r.alias }}</span>{% endif %}
                </h3>
                <p class="role-desc">{{ r.desc }}</p>
                {% set others = r.also | reject('equalto', r.alias) | list %}
                {% if others %}
                <p class="role-also">이렇게도 부릅니다 — {{ others | join(' · ') }}</p>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endfor %}
    </div>
</section>

<section style="background:#f8f9fa;">
    <div class="container">
        <h2>찾으시는 일이 없으신가요?</h2>
        <a href="tel:{{ region.phones[0].number }}" class="call-cta">
            📞 전화로 물어보기 {{ region.phones[0].number }}
            <small>하시려는 일을 말씀해 주시면 맞는 인력을 찾아드립니다</small>
        </a>

        <div class="fork-grid" style="margin-top:2rem;">
            <a href="{{ link('hire') }}" class="fork-card fork-hire">
                <span class="fork-icon">🏢</span>
                <span class="fork-title">인력 요청하기</span>
                <span class="fork-sub">현장에 사람이 필요하신 분</span>
            </a>
            <a href="{{ link('job') }}" class="fork-card fork-job">
                <span class="fork-icon">👷</span>
                <span class="fork-title">일자리 찾기</span>
                <span class="fork-sub">일하실 분 · 구직 등록</span>
            </a>
        </div>

        {% if region.rates_verified %}
        <p style="text-align:center;margin-top:1.5rem;">
            <a href="{{ link('rates') }}" style="color:#1e3c72;font-weight:bold;">
                직종별 일당 시세 보기 →
            </a>
        </p>
        {% endif %}
    </div>
</section>
{% endblock %}

{% block extra_css %}
        .role-group { max-width: 820px; margin: 0 auto 2.5rem; }

        .role-group-name {
            text-align: left;
            font-size: 1.15rem;
            color: #fff;
            background: #1e3c72;
            border-radius: 8px;
            padding: .55rem 1rem;
            margin: 2rem 0 1rem;
        }

        .role-card {
            padding: 1.1rem 1.1rem 1.15rem;
            border-bottom: 1px solid #e9ecf2;
        }

        .role-card:last-child { border-bottom: none; }

        .role-name { font-size: 1.1rem; color: #1e3c72; margin-bottom: .35rem; }

        /* 대표 현장호칭 — "가다와꾸"로만 아는 분이 자기 일을 알아볼 수 있어야 한다 */
        .role-alias {
            display: inline-block;
            margin-left: .5rem;
            font-size: .9rem;
            font-weight: normal;
            color: #b07b18;
            background: #fff6e2;
            border-radius: 20px;
            padding: .1rem .6rem;
        }

        .role-desc { color: #444; margin-bottom: .4rem; }

        .role-also { font-size: .88rem; color: #8a8f98; }

        @media (max-width: 768px) {
            .role-group-name { font-size: 1.05rem; }
            .role-card { padding: 1rem .2rem 1.05rem; }
        }
{% endblock %}
