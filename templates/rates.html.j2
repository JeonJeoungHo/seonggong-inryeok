{% extends "_base.html.j2" %}

{# 직종별 일당 시세 — 검색 유입의 핵심 페이지.
   "파주 형틀목수 일당" 같은 검색은 실수요 검색인데 답을 주는 사이트가 거의 없다.
   목록의 현장 별칭(가다와꾸·곰빵·아시바)이 그대로 롱테일 검색어가 된다.

   ⚠️ 여기 숫자는 공개된 순간 단가 분쟁의 근거로 인용된다. 그래서
      ① 기준 시점을 명시하고 ② "조건에 따라 달라진다"를 숫자 옆에 붙이고
      ③ 공표 노임단가가 있는 직종은 출처를 같이 보여준다. #}

{% set d = region.rates %}

{% block seo_title %}{{ d.seo.title }}{% endblock %}
{% block seo_description %}{{ d.seo.description }}{% endblock %}
{% block seo_keywords %}{{ d.seo.keywords }}{% endblock %}
{% block og_title %}{{ d.seo.og_title }}{% endblock %}
{% block og_description %}{{ d.seo.og_description }}{% endblock %}

{% block content %}
<div class="topbar">
    <div class="container">
        <a href="{{ link('home') }}" class="brand">{{ region.name }}</a>
        <a href="{{ link('hire') }}" class="home-link">인력 요청 →</a>
    </div>
</div>

<div class="page-head">
    <div class="container">
        <h1>{{ d.headline }}</h1>
        <p>{{ d.sub }}</p>
    </div>
</div>

{% if region.get('rates_verified') %}
<section>
    <div class="container">
        <div class="rate-table">
            {% for r in region.rates_verified %}
            <div class="rate-row">
                <div class="rate-name">
                    {{ r.role }}
                    {% if r.get('alias') %}<span class="rate-alias">{{ r.alias }}</span>{% endif %}
                </div>
                <div class="rate-price">
                    {{ '{:,}'.format(r.low) }}원 ~ {{ '{:,}'.format(r.high) }}원
                    {% if r.get('source') %}<span class="rate-source">{{ r.source }}</span>{% endif %}
                </div>
            </div>
            {% endfor %}
        </div>

        {# "공표 시중노임단가 276,000원"이 숫자만 덩그러니 있었다(2026-10-01).
           ★ **같은 표를 양쪽이 본다.** 소장은 "공표보다 싸네"로, 일하실 분은
             "공표보다 덜 주네"로 읽는다. 실제로 비계공은 공표(282,000)가 우리
             상한(280,000)보다 높다 — 설명이 없으면 오해만 남는다.
           ⚠️ 숨기지 않는다. 밝혀두는 쪽이 맞고, **무엇과 비교한 숫자인지**만
              말해주면 된다. #}
        {% if region.rates_verified | selectattr('source') | list %}
        <p class="note note-source">
            ℹ️ <b>공표 시중노임단가</b>는 건설업계가 조사해 반년마다 발표하는
            기준 금액입니다. 비교해 보시라고 같이 적었습니다 —
            실제 일당은 현장 조건과 그날 사정에 따라 이보다 오르기도 내리기도 합니다.
        </p>
        {% endif %}

        <p class="note">
            {% if region.get('rates_updated') %}{{ region.rates_updated }} 기준 · {% endif %}
            1인 1일 기준입니다.<br>
            현장 조건(층수 · 자재 운반 · 작업 강도 · 작업 기간)에 따라 달라지므로,
            정확한 금액은 현장 이야기를 듣고 안내해 드립니다.
        </p>
        <p class="note">
            표에 없는 직종도 대부분 연결해 드립니다. 전화로 물어봐 주세요.
        </p>
        {# 일당 계산기 (2026-10-01) — 소장이 표를 보고 제일 먼저 하는 계산이
           "그럼 5명 사흘이면 얼마야?"다. 그걸 머리로 하게 두지 않는다.

           ★ 계산기는 **표의 금액에 곱하기만** 한다. 그 금액이 무엇인지는 표와
             아래 안내가 이미 말하고 있으니, 계산기가 새 해석을 보태지 않는다.
             (교통비·식대·소개비를 여기서 끼워 넣으면 그 순간 틀린 숫자가 된다.)
           ★ 끝은 **전화**로 보낸다. 계산기는 답이 아니라 전화를 걸 이유다.
           ⚠️ 서버가 첫 직종 1명 1일로 미리 그려둔다 — JS가 늦거나 막혀도
              빈 칸이 아니라 숫자가 보인다. #}
        {% set first = region.rates_verified[0] %}
        <div class="calc" id="rateCalc"
             data-rates='{{ region.rates_verified | map(attribute="low") | list | tojson }}'
             data-highs='{{ region.rates_verified | map(attribute="high") | list | tojson }}'
             data-names='{{ region.rates_verified | map(attribute="role") | list | tojson }}'>
            <h3 class="calc-head">💰 얼마나 들까요?</h3>

            <div class="calc-row">
                <label class="calc-label" for="calcRole">직종</label>
                <select id="calcRole" class="calc-select">
                    {% for r in region.rates_verified %}
                    <option value="{{ loop.index0 }}">{{ r.role }}{% if r.get('alias') %} ({{ r.alias }}){% endif %}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="calc-row">
                <label class="calc-label">인원</label>
                <div class="calc-step">
                    <button type="button" class="calc-btn" data-step="people" data-delta="-1" aria-label="인원 줄이기">−</button>
                    <span class="calc-num" id="calcPeople">1</span><span class="calc-unit">명</span>
                    <button type="button" class="calc-btn" data-step="people" data-delta="1" aria-label="인원 늘리기">+</button>
                </div>
            </div>

            <div class="calc-row">
                <label class="calc-label">일수</label>
                <div class="calc-step">
                    <button type="button" class="calc-btn" data-step="days" data-delta="-1" aria-label="일수 줄이기">−</button>
                    <span class="calc-num" id="calcDays">1</span><span class="calc-unit">일</span>
                    <button type="button" class="calc-btn" data-step="days" data-delta="1" aria-label="일수 늘리기">+</button>
                </div>
            </div>

            <div class="calc-out">
                <strong id="calcTotal">{{ '{:,}'.format(first.low) }}원 ~ {{ '{:,}'.format(first.high) }}원</strong>
                <small id="calcWhat">{{ first.role }} 1명 × 1일</small>
            </div>

            <p class="calc-note">
                표의 금액에 인원과 일수를 곱한 값입니다.
                현장 조건에 따라 달라지니 <b>정확한 금액은 전화로</b> 알려드립니다.
            </p>
            <a href="tel:{{ region.phones[0].number }}" class="calc-call">
                📞 정확한 금액 물어보기 {{ region.phones[0].number }}
            </a>
        </div>

        <p class="sub-links">
            <a href="{{ link('roles') }}">각 직종이 무슨 일인지 보기 →</a>
        </p>
    </div>
</section>
{% else %}
<section>
    <div class="container">
        <p class="note">
            일당은 직종과 현장 조건에 따라 달라집니다.<br>
            전화 주시면 현장 이야기를 듣고 바로 알려드립니다.
        </p>
    </div>
</section>
{% endif %}

<section style="background:#f8f9fa;">
    <div class="container">
        <h2>직접 물어보시는 게 빠릅니다</h2>
        <a href="tel:{{ region.phones[0].number }}" class="call-cta">
            📞 일당 문의 {{ region.phones[0].number }}
            <small>현장 조건을 말씀해주시면 바로 알려드립니다</small>
        </a>

        <div class="fork-grid" style="margin-top:2rem;">
            <a href="{{ link('hire') }}" class="fork-card fork-hire">
                <span class="fork-icon">🏢</span>
                <span class="fork-title">인력 요청하기</span>
                <span class="fork-sub">현장에 사람이 필요하신 분</span>
            </a>
            <a href="{{ link('job') }}" class="fork-card fork-job">
                <span class="fork-icon">👷</span>
                <span class="fork-title">일자리 찾기</span>
                <span class="fork-sub">일하실 분 · 구직 등록</span>
            </a>
        </div>
    </div>
</section>
{% endblock %}

{% block extra_css %}
        .rate-table { max-width: 760px; margin: 0 auto; }

        .rate-row {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 1rem;
            padding: 1.05rem .4rem;
            border-bottom: 1px solid #e5e8ee;
        }

        .rate-row:last-child { border-bottom: none; }

        .rate-name { font-weight: bold; color: #1e3c72; font-size: 1.05rem; }

        /* 현장 별칭 — "가다와꾸"로만 아는 분이 자기 직종을 찾을 수 있어야 한다 */
        .rate-alias {
            display: inline-block;
            margin-left: .45rem;
            font-weight: normal;
            font-size: .88rem;
            color: #8a8f98;
        }

        .rate-price { text-align: right; font-size: 1.05rem; color: #333; white-space: nowrap; }

        .rate-source {
            display: block;
            font-size: .82rem;
            color: #8a8f98;
            white-space: normal;
        }

        @media (max-width: 768px) {
            .rate-row { flex-direction: column; align-items: flex-start; gap: .25rem; }
            .rate-price { text-align: left; }
        }
{% endblock %}
