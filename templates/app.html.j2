{% extends "_base.html.j2" %}

{# 바로일감 설치 안내 — 배정된 인부가 현장에서 쓰는 앱.

   이 페이지가 있는 이유: 카톡으로 링크 하나만 보내면 되게 하려고.
   "크롬에서 열고 점 세 개 누르고…"를 전화로 설명하는 것보다 훨씬 빠르다.

   ⚠️ 아이폰은 반드시 사파리여야 한다. 크롬으로 열면 '홈 화면에 추가'가 없다 —
      현장에서 제일 많이 막히는 지점이라 눈에 띄게 적어둔다. #}

{% set d = region.worker_app %}

{% block seo_title %}{{ d.seo.title }}{% endblock %}
{% block seo_description %}{{ d.seo.description }}{% endblock %}
{% block seo_keywords %}{{ d.seo.keywords }}{% endblock %}
{% block og_title %}{{ d.seo.og_title }}{% endblock %}
{% block og_description %}{{ d.seo.og_description }}{% endblock %}

{% block content %}
<div class="topbar">
    <div class="container">
        <a href="{{ link('home') }}" class="brand">{{ region.name }}</a>
        <a href="tel:{{ region.phones[0].number }}" class="home-link">📞 {{ region.phones[0].number }}</a>
    </div>
</div>

<div class="page-head">
    <div class="container">
        <h1>{{ d.name }} 앱 설치하기</h1>
        <p>{{ d.tagline }}</p>
    </div>
</div>

{% if d.get('audiences') %}
<section>
    <div class="container">
        <h2>누가 쓰나요</h2>
        <ul class="info-list">
            {% for a in d.audiences %}
            <li>
                <strong>{{ a.icon }} {{ a.who }}</strong>
                {{ a.what }}
            </li>
            {% endfor %}
        </ul>
        <p class="note">
            세 분이 같은 앱을 쓰지만, 로그인하시면 <strong>각자에게 필요한 화면만</strong> 보입니다.
        </p>
    </div>
</section>
{% endif %}

<section{% if d.get('audiences') %} style="background:#f8f9fa;"{% endif %}>
    <div class="container">
        <p class="note" style="font-size:1.02rem;color:var(--ink);">{{ d.what }}</p>

        <a href="{{ d.url }}" class="call-cta" style="background:var(--navy);box-shadow:0 6px 18px rgba(30,60,114,.30);" target="_blank" rel="noopener">
            📱 {{ d.name }} 열기
            <small>먼저 열어보시고, 아래 방법으로 홈 화면에 추가하세요</small>
        </a>

        <p class="note">
            설치라고 해도 따로 받는 게 아닙니다. <strong>홈 화면에 아이콘을 하나 만드는 것</strong>이라
            용량을 거의 차지하지 않고, 지우는 것도 아이콘만 지우면 됩니다.
        </p>
    </div>
</section>

<section style="background:#f8f9fa;">
    <div class="container">
        <h2>📱 안드로이드 (삼성·LG 등)</h2>
        <ol class="step-list">
            <li>
                <strong>크롬으로 {{ d.url }} 접속</strong>
                <span>위의 파란 버튼을 눌러 여셔도 됩니다.</span>
            </li>
            <li>
                <strong>화면 오른쪽 위 점 세 개(⋮) 누르기</strong>
                <span>주소창 옆에 있습니다.</span>
            </li>
            <li>
                <strong>"앱 설치" 또는 "홈 화면에 추가" 누르기</strong>
                <span>휴대폰에 따라 문구가 조금 다릅니다.</span>
            </li>
            <li>
                <strong>설치 누르기</strong>
                <span>홈 화면에 {{ d.name }} 아이콘이 생깁니다. 이제 그 아이콘으로 바로 들어가시면 됩니다.</span>
            </li>
        </ol>
    </div>
</section>

<section>
    <div class="container">
        <h2>🍎 아이폰</h2>
        <p class="note warn">
            ⚠️ 아이폰은 <strong>반드시 사파리(Safari)</strong>로 여셔야 합니다.<br>
            크롬으로 열면 "홈 화면에 추가"가 나오지 않습니다.
        </p>
        <ol class="step-list step-list-job">
            <li>
                <strong>사파리로 {{ d.url }} 접속</strong>
                <span>나침반 모양의 기본 브라우저입니다.</span>
            </li>
            <li>
                <strong>화면 아래 공유 버튼 누르기</strong>
                <span>네모에서 화살표가 위로 나가는 모양입니다.</span>
            </li>
            <li>
                <strong>목록을 내려서 "홈 화면에 추가" 누르기</strong>
                <span>조금 아래쪽에 있습니다.</span>
            </li>
            <li>
                <strong>오른쪽 위 "추가" 누르기</strong>
                <span>홈 화면에 {{ d.name }} 아이콘이 생깁니다.</span>
            </li>
        </ol>
    </div>
</section>

<section style="background:#f8f9fa;">
    <div class="container">
        <h2>잘 안 되시나요?</h2>
        <a href="tel:{{ region.phones[0].number }}" class="call-cta">
            📞 전화 주세요 {{ region.phones[0].number }}
            <small>같이 보면서 알려드립니다</small>
        </a>
        <p class="sub-links">
            <a href="{{ link('job') }}">구직 등록하기 →</a>
            <a href="{{ link('guide') }}">이용 방법 →</a>
        </p>
    </div>
</section>
{% endblock %}

{% block extra_css %}
        /* 이용 방법 페이지와 같은 번호 목록을 쓴다 */
        .step-list { max-width: 760px; margin: 0 auto; list-style: none; counter-reset: step; }

        .step-list li {
            position: relative;
            counter-increment: step;
            padding: 0 0 1.6rem 3.3rem;
        }

        .step-list li::before {
            content: counter(step);
            position: absolute;
            left: 0;
            top: 0;
            width: 2.2rem;
            height: 2.2rem;
            border-radius: 50%;
            background: var(--navy);
            color: #fff;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .step-list li:not(:last-child)::after {
            content: "";
            position: absolute;
            left: 1.05rem;
            top: 2.4rem;
            bottom: .35rem;
            width: 2px;
            background: #dfe4ee;
        }

        .step-list li strong { display: block; color: var(--navy); margin-bottom: .2rem; }
        .step-list li span { color: var(--ink-soft); }

        .step-list-job li::before { background: var(--amber); color: #3a2a05; }

        /* 아이폰 주의 문구 — 현장에서 제일 많이 막히는 지점이라 눈에 띄게 */
        .note.warn {
            background: #fff8e8;
            border: 1px solid #f3dfae;
            border-radius: var(--radius);
            padding: 1rem 1.2rem;
            color: #7a5a12;
            margin-bottom: 1.6rem;
        }

        @media (max-width: 768px) {
            .step-list li { padding-left: 2.9rem; }
        }
{% endblock %}
