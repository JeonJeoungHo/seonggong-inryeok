{% extends "_base.html.j2" %}

{# 이용 방법 — 인력사무소를 처음 쓰는 사람을 위한 페이지.

   구인·구직 페이지는 각자 "무엇을 할 수 있는지"를 말하지만, 처음 오는 사람은
   그 앞에서 막힌다 — 전화하면 뭘 물어보는지, 언제 사람이 오는지, 돈은 언제 오가는지.
   그 흐름을 한 장에 펼쳐 불안을 덜어주는 자리다.

   ⚠️ 여기 적힌 지급 시점은 /job/ 의 pay_timing 과 같은 사실이어야 한다. #}

{% set d = region.guide %}

{% block seo_title %}{{ d.seo.title }}{% endblock %}
{% block seo_description %}{{ d.seo.description }}{% endblock %}
{% block seo_keywords %}{{ d.seo.keywords }}{% endblock %}
{% block og_title %}{{ d.seo.og_title }}{% endblock %}
{% block og_description %}{{ d.seo.og_description }}{% endblock %}

{% block content %}
<div class="topbar">
    <div class="container">
        <a href="{{ link('home') }}" class="brand">{{ region.name }}</a>
        <a href="tel:{{ region.phones[0].number }}" class="home-link">📞 {{ region.phones[0].number }}</a>
    </div>
</div>

<div class="page-head">
    <div class="container">
        <h1>{{ d.headline }}</h1>
        <p>{{ d.sub }}</p>
    </div>
</div>

<section>
    <div class="container">
        <h2>🏢 인력이 필요하신 분</h2>
        <ol class="step-list">
            {% for s in d.hire_steps %}
            <li>
                <strong>{{ s.title }}</strong>
                <span>{{ s.desc }}</span>
            </li>
            {% endfor %}
        </ol>
        <p class="sub-links">
            <a href="{{ link('hire') }}">인력 요청 안내 보기 →</a>
        </p>
    </div>
</section>

<section style="background:#f8f9fa;">
    <div class="container">
        <h2>👷 일자리를 찾으시는 분</h2>
        <ol class="step-list step-list-job">
            {% for s in d.job_steps %}
            <li>
                <strong>{{ s.title }}</strong>
                <span>{{ s.desc }}</span>
            </li>
            {% endfor %}
        </ol>
        <p class="sub-links">
            <a href="{{ link('job') }}">구직 안내 보기 →</a>
            {% if region.get('worker_app') %}
            <a href="{{ link('app') }}">{{ region.worker_app.name }} 설치 →</a>
            {% endif %}
        </p>
    </div>
</section>

<section>
    <div class="container">
        <h2>궁금한 건 전화가 제일 빠릅니다</h2>
        <a href="tel:{{ region.phones[0].number }}" class="call-cta">
            📞 전화 상담 {{ region.phones[0].number }}
            <small>처음이셔도 괜찮습니다. 상황만 말씀해 주세요</small>
        </a>
        <p class="sub-links">
            {% if region.get('rates_verified') %}
            <a href="{{ link('rates') }}">일당 시세 →</a>
            {% endif %}
            <a href="{{ link('roles') }}">직종 안내 →</a>
        </p>
    </div>
</section>
{% endblock %}

{% block extra_css %}
        .step-list {
            max-width: 760px;
            margin: 0 auto;
            list-style: none;
            counter-reset: step;
        }

        .step-list li {
            position: relative;
            counter-increment: step;
            padding: 0 0 1.6rem 3.3rem;
        }

        /* 번호 원 */
        .step-list li::before {
            content: counter(step);
            position: absolute;
            left: 0;
            top: 0;
            width: 2.2rem;
            height: 2.2rem;
            border-radius: 50%;
            background: #1e3c72;
            color: #fff;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* 번호와 번호를 잇는 세로줄 — 마지막 항목 아래로는 그리지 않는다 */
        .step-list li:not(:last-child)::after {
            content: "";
            position: absolute;
            left: 1.05rem;
            top: 2.4rem;
            bottom: .35rem;
            width: 2px;
            background: #dfe4ee;
        }

        .step-list li strong { display: block; color: #1e3c72; margin-bottom: .2rem; }
        .step-list li span { color: #555; }

        .step-list-job li::before { background: #F5A623; color: #3a2a05; }

        @media (max-width: 768px) {
            .step-list li { padding-left: 2.9rem; }
        }
{% endblock %}
