{% extends "_base.html.j2" %}

{# 홈 — 갈림길이 첫 화면에 온다.
   소장은 "오늘 3명"이 급하고 인부는 "내일 나갈 현장"이 급한데, 둘을 한 페이지에
   섞어두면 누구의 질문에도 답을 못 한다. 여기서는 길만 갈라주고 답은 각 페이지가 한다. #}

{% block content %}
<header>
    <div class="container">
        <img src="{{ asset(region.signboard) }}" alt="{{ region.signboard_alt }}" style="max-width:100%;border-radius:10px;margin-bottom:1rem;">
        <h1 itemprop="name">{{ region.name }}</h1>
        <p itemprop="description">
            {% for line in region.tagline_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}
        </p>
    </div>
</header>

<section class="fork">
    <div class="container">
        <a href="tel:{{ region.phones[0].number }}" class="call-cta">
            📞 전화 상담 {{ region.phones[0].number }}
            <small>바로 연결됩니다</small>
        </a>

        <div class="fork-grid">
            <a href="{{ link('hire') }}" class="fork-card fork-hire">
                <span class="fork-icon">🏢</span>
                <span class="fork-title">사람이 필요합니다</span>
                <span class="fork-sub">현장에 인력을 부르시는 분</span>
            </a>
            <a href="{{ link('job') }}" class="fork-card fork-job">
                <span class="fork-icon">👷</span>
                <span class="fork-title">일자리를 찾습니다</span>
                <span class="fork-sub">일하실 분 · 구직 등록</span>
            </a>
        </div>

        {# 내일 날씨 (2026-10-01) — 건설에서 비는 재미가 아니라 생존 정보다.
           비 오면 그날 일이 없어서, 인부도 소장도 전날 밤에 날씨를 본다.
           ★ 늘어놓지 않는다. 습도·풍속은 날씨 앱이 할 일이고 우리는
             **일이 있냐 없냐**만 답한다 — 비 오는가, 아침이 몇 도인가.
           ⚠️ 서버가 미리 못 그린다(실시간 값이다). 그래서 **기본은 숨김**이고
              값이 와야 보인다 — 못 받아오면 오류 대신 조용히 없는 셈이 된다. #}
        {% if region.get('weather_point') %}
        <a class="weather-band" id="weatherBand" hidden
           href="https://www.weather.go.kr/w/weather/forecast/short-term.do" target="_blank" rel="noopener"
           data-lat="{{ region.weather_point.lat }}" data-lon="{{ region.weather_point.lon }}"
           data-label="{{ region.weather_point.label }}">
            <span class="weather-icon" id="weatherIcon" aria-hidden="true">☁️</span>
            <span class="weather-text">
                <b id="weatherHead"></b>
                <small id="weatherSub"></small>
            </span>
        </a>
        {% endif %}

        {# 하루 한 줄 (2026-10-01 정호님) — "정보도 얻고 문의도 되는데 재미가 없다"에서 나왔다.
           ★ 자리는 **전화 버튼과 갈림길 아래**다. 맨 위에 두면 "파주 인력사무소"를
             찾아온 분이 개그부터 보게 된다 — 간판·전화·갈림길이 먼저다.
           ★ 서버가 미리 하나를 그려둔다. JS로만 채우면 로딩 순간 빈 줄이었다가
             글이 들어오며 화면이 덜컹이고, JS가 막히면 영영 빈칸이다.
             **오늘 것으로 바꾸는 일만** JS가 한다(_base.html.j2 아래쪽). #}
        <p class="daily-line" id="dailyLine">{{ daily.lines[0].text }}</p>

        <p class="sub-links">
            <a href="{{ link('guide') }}">처음이신가요? 이용 방법 →</a>
            {% if region.get('rates_verified') %}
            <a href="{{ link('rates') }}">직종별 일당 시세 →</a>
            {% endif %}
            <a href="{{ link('roles') }}">건설 직종 안내 →</a>
            {% if region.get('worker_app') %}
            <a href="{{ link('app') }}">{{ region.worker_app.name }} 앱 →</a>
            {% endif %}
        </p>

        {# 갈림길 '아래'에 둔다. 첫 화면(간판 → 전화 → 갈림길)은 건드리지 않고,
           한 번 내리면 보이는 자리다. 처음 오신 분의 길을 흐리지 않으려고. #}
        {% if region.get('worker_app') %}
        <a href="{{ link('app') }}" class="app-band">
            <span class="app-band-head">📱 {{ region.worker_app.name }}</span>
            <span class="app-band-sub">{{ region.worker_app.tagline }}</span>
            <span class="app-band-body">{{ region.worker_app.blurb }}</span>
            <span class="app-band-more">알아보기 →</span>
        </a>
        {% endif %}
    </div>
</section>

<div class="container">
    <div class="emergency-contact">
        <h2>📞 상담 안내</h2>
        <div class="phone-numbers">
            {% for p in region.phones %}
            <div class="phone-number">
                <strong>{{ p.label }}</strong><br>
                <a href="tel:{{ p.number }}">{{ p.number }}</a>
            </div>
            {% endfor %}
        </div>
        <p style="margin-top:1rem;">
            ※ 네이버 플레이스에서 업체 정보를 확인하실 수 있습니다.
        </p>
    </div>
</div>

<section>
    <div class="container">
        <h2>{{ region.intro_title }}</h2>
        <p style="text-align:center;">
            {% for line in region.intro_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}
        </p>
    </div>
</section>

<section class="services">
    <div class="container">
        <h2>주요 서비스</h2>
        <div class="service-grid">
            {% for s in region.services %}
            <div class="service-card">
                <div class="icon">{{ s.icon }}</div>
                <h3>{{ s.title }}</h3>
                <p>{{ s.desc }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<section class="why-success">
    <div class="why-inner">
        <h2 class="why-title">왜 {{ region.name }}인가요?</h2>

        <div class="why-grid">
            {% for w in region.why_items %}
            <div class="why-item">
                <h3><span class="check">✔</span> {{ w.title }}</h3>
                <p>{{ w.desc }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<section>
    <div class="container">
        <h2>공식 안내</h2>
        <p style="text-align:center;">
            {% for line in region.official_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}
        </p>
        <p style="text-align:center;margin-top:1rem;">
            👉 <a href="{{ region.naver_blog }}" target="_blank">네이버 블로그 바로가기</a><br>
            👉 <a href="{{ region.naver_place }}" target="_blank">네이버 플레이스에서 {{ region.name }} 보기</a>
        </p>
    </div>
</section>
{% endblock %}

{% block extra_css %}
        /* 바로일감 안내 띠 — 갈림길 아래. 구인·구직 카드보다 조용해야 한다.
           여기가 시끄러우면 처음 오신 분이 전화 걸기까지의 거리가 멀어진다. */
        .app-band {
            display: block;
            max-width: 760px;
            margin: 1.8rem auto 0;
            padding: 1.4rem 1.5rem;
            background: var(--tint);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            text-decoration: none;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

        .app-band:hover { border-color: #c8d3e6; box-shadow: var(--shadow); }

        .app-band-head {
            display: block;
            font-weight: bold;
            font-size: 1.1rem;
            color: var(--navy);
            margin-bottom: .15rem;
        }

        .app-band-sub {
            display: block;
            font-size: .95rem;
            color: var(--navy);
            opacity: .8;
            margin-bottom: .5rem;
        }

        .app-band-body {
            display: block;
            font-size: .93rem;
            color: var(--ink-soft);
            line-height: 1.6;
        }

        .app-band-more {
            display: block;
            margin-top: .6rem;
            font-size: .93rem;
            font-weight: bold;
            color: var(--navy);
        }

        @media (max-width: 768px) {
            .app-band { padding: 1.15rem 1.1rem; margin-top: 1.4rem; }
            .app-band-head { font-size: 1.05rem; }
        }

        /* 왜 성공인력인가요 — 홈에서만 쓴다 */
        .why-success { padding: 100px 20px; background: #ffffff; }
        .why-inner { max-width: 1100px; margin: 0 auto; }

        .why-title {
            text-align: center;
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 60px;
            color: #1f3c88;
        }

        .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }

        .why-item {
            background: #f9fafc;
            border-radius: 16px;
            padding: 30px 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
            transition: transform 0.3s ease;
        }

        .why-item:hover { transform: translateY(-5px); }
        .why-item h3 { font-size: 18px; font-weight: 700; margin-bottom: 10px; color: #222; }
        .why-item p { font-size: 15px; color: #555; line-height: 1.6; margin: 0; }
        .why-item .check { color: #2ecc71; margin-right: 6px; }

        @media (max-width: 768px) {
            .why-grid { grid-template-columns: 1fr; gap: 20px; }
            .why-title { font-size: 26px; }
            .why-success { padding: 60px 20px; }
        }
{% endblock %}
