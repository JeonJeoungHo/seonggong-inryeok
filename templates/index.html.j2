{#
  지역 사무소 페이지 — 전 지역이 이 템플릿 한 벌을 쓴다.
  여기를 고치면 모든 지역이 같이 고쳐진다. 지역마다 다른 값은 regions/*.json에서 온다.
#}<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{ region.seo.title }}</title>

    <!-- SEO 기본 -->
    <meta name="description" content="{{ region.seo.description }}">
    <meta name="keywords" content="{{ region.seo.keywords }}">
    <meta name="author" content="{{ region.name }}">
    <meta name="robots" content="index, follow">

    <!-- 네이버 / 구글 -->
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">

    <!-- 아이콘 -->
    <link rel="icon" href="{{ asset('/favicon.ico') }}" sizes="any">
    <link rel="apple-touch-icon" href="{{ asset('/apple-touch-icon.png') }}">

    <!-- Open Graph — 카톡으로 링크를 보냈을 때 뜨는 카드 -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ region.seo.og_title }}">
    <meta property="og:description" content="{{ region.seo.og_description }}">
    <meta property="og:url" content="{{ page_url }}">
    <meta property="og:site_name" content="{{ site.brand }}">
    {% if region.og_image %}
    <meta property="og:image" content="{{ ascii_base }}{{ region.og_image }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    {% endif %}

    <link rel="canonical" href="{{ page_url }}">

    <script type="application/ld+json">
{{ jsonld | safe }}
    </script>

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Malgun Gothic', sans-serif; line-height: 1.6; color: #333; }

        header {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            padding: 2rem 0;
            text-align: center;
        }

        header h1 { font-size: 2.5rem; margin-bottom: .5rem; }
        header p { font-size: 1.1rem; opacity: .95; }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

        .emergency-contact {
            background: #fff3cd;
            border-left: 5px solid #ffc107;
            padding: 1.5rem;
            margin: 2rem 0;
            text-align: center;
        }

        .phone-numbers {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .phone-number {
            background: white;
            padding: 1rem 2rem;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,.1);
        }

        .phone-number a {
            font-size: 1.4rem;
            font-weight: bold;
            color: #1e3c72;
            text-decoration: none;
        }

        section { padding: 3rem 0; }
        h2 { text-align: center; font-size: 2rem; margin-bottom: 2rem; color: #1e3c72; }

        .service-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px,1fr));
            gap: 2rem;
        }

        .service-card {
            background: #fff;
            padding: 2rem;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0 3px 10px rgba(0,0,0,.1);
        }

        /* 온라인 신청 섹션 */
        .online-apply {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 4rem 0;
            color: white;
        }

        .online-apply h2 {
            color: white;
            margin-bottom: 1rem;
        }

        .online-apply p {
            text-align: center;
            font-size: 1.1rem;
            margin-bottom: 3rem;
            opacity: 0.95;
        }

        .apply-buttons {
            display: flex;
            justify-content: center;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .apply-btn {
            background: white;
            color: #667eea;
            padding: 1.5rem 3rem;
            border-radius: 50px;
            text-decoration: none;
            font-size: 1.2rem;
            font-weight: bold;
            box-shadow: 0 5px 15px rgba(0,0,0,.2);
            transition: all 0.3s ease;
            display: inline-block;
            white-space: nowrap;
        }

        .apply-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,.3);
        }

        .apply-btn.job-seeker {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .apply-btn.employer {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
        }

        footer {
            background: #1e3c72;
            color: white;
            text-align: center;
            padding: 2rem 0;
        }

        .floating-buttons {
            position: fixed;
            bottom: 25px;
            right: 25px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            z-index: 1000;
        }

        .floating-btn {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: white;
            text-decoration: none;
            box-shadow: 0 4px 10px rgba(0,0,0,.3);
            transition: transform 0.3s ease;
        }

        .floating-btn:hover {
            transform: scale(1.1);
        }

        /* 왜 성공인력인가요 */
        .why-success {
            padding: 100px 20px;
            background: #ffffff;
        }

        .why-inner {
            max-width: 1100px;
            margin: 0 auto;
        }

        .why-title {
            text-align: center;
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 60px;
            color: #1f3c88;
        }

        .why-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 40px;
        }

        .why-item {
            background: #f9fafc;
            border-radius: 16px;
            padding: 30px 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
            transition: transform 0.3s ease;
        }

        .why-item:hover {
            transform: translateY(-5px);
        }

        .why-item h3 {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #222;
        }

        .why-item p {
            font-size: 15px;
            color: #555;
            line-height: 1.6;
            margin: 0;
        }

        .why-item .check {
            color: #2ecc71;
            margin-right: 6px;
        }

        /* 하단 고정 바 (모바일)
           동그란 플로팅 버튼이 본문과 "인력 구하기" 버튼 위에 겹쳐 있었다.
           제일 중요한 버튼을 가리고 있었기 때문에 바로 바꾼다. 바는 아무것도 안 가리고
           항상 보인다. 데스크탑에서는 여백이 넉넉해 겹치지 않으므로 기존 플로팅 유지. */
        .bottom-bar { display: none; }

        @media (max-width: 768px) {
            .floating-buttons { display: none; }

            .bottom-bar {
                display: flex;
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 1000;
                box-shadow: 0 -2px 12px rgba(0,0,0,.25);
            }

            .bottom-bar a {
                flex: 1;
                padding: 14px 4px;
                text-align: center;
                text-decoration: none;
                font-size: 15px;
                font-weight: bold;
                line-height: 1.3;
            }

            .bottom-bar .bar-call { background: #28a745; color: #fff; }
            .bottom-bar .bar-kakao { background: #FEE500; color: #3C1E1E; }
            .bottom-bar .bar-apply { background: #1e3c72; color: #fff; }

            /* 바에 가려 푸터 마지막 줄이 안 읽히지 않도록 */
            body { padding-bottom: 56px; }
        }

        /* 모바일 */
        @media (max-width: 768px) {
            .why-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .why-title {
                font-size: 26px;
            }

            .apply-buttons {
                flex-direction: column;
                align-items: center;
            }

            .apply-btn {
                width: 90%;
                max-width: 300px;
                font-size: 1rem;
                padding: 1.2rem 1.5rem;
            }

            header h1 { font-size: 2rem; }
        }

        .phone { background: #28a745; }
        .kakao { background: #FEE500; color: #3C1E1E; }
    </style>
</head>

<body itemscope itemtype="http://schema.org/LocalBusiness">

<header>
    <div class="container">
        <img src="{{ asset(region.signboard) }}" alt="{{ region.signboard_alt }}" style="max-width:100%;border-radius:10px;margin-bottom:1rem;">
        <h1 itemprop="name">{{ region.name }}</h1>
        <p itemprop="description">
            {% for line in region.tagline_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}
        </p>
    </div>
</header>

<div class="container">
    <div class="emergency-contact">
        <h2>📞 상담 안내</h2>
        <div class="phone-numbers">
            {% for p in region.phones %}
            <div class="phone-number">
                <strong>{{ p.label }}</strong><br>
                <a href="tel:{{ p.number }}">{{ p.number }}</a>
            </div>
            {% endfor %}
        </div>
        <p style="margin-top:1rem;">
            ※ 네이버 플레이스에서 업체 정보를 확인하실 수 있습니다.
        </p>
    </div>
</div>

<section>
    <div class="container">
        <h2>{{ region.intro_title }}</h2>
        <p style="text-align:center;">
            {% for line in region.intro_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}
        </p>
    </div>
</section>

<section class="services">
    <div class="container">
        <h2>주요 서비스</h2>
        <div class="service-grid">
            {% for s in region.services %}
            <div class="service-card">
                <div class="icon">{{ s.icon }}</div>
                <h3>{{ s.title }}</h3>
                <p>{{ s.desc }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- 🆕 온라인 신청 섹션 추가 -->
<section class="online-apply">
    <div class="container">
        <h2>💻 온라인 신청</h2>
        <p>
            전화가 어려우신가요?<br>
            아래 버튼을 눌러 온라인으로 간편하게 신청하세요!
        </p>
        <div class="apply-buttons">
            <a href="{{ region.apply_links.job_seeker }}" class="apply-btn job-seeker" target="_blank">
                👤 일자리 찾기 (구직 신청)
            </a>
            <a href="{{ region.apply_links.employer }}" class="apply-btn employer" target="_blank">
                🏢 인력 구하기 (채용 공고)
            </a>
        </div>
    </div>
</section>

<section class="why-success">
    <div class="why-inner">
        <h2 class="why-title">왜 {{ region.name }}인가요?</h2>

        <div class="why-grid">
            {% for w in region.why_items %}
            <div class="why-item">
                <h3><span class="check">✔</span> {{ w.title }}</h3>
                <p>{{ w.desc }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<section>
    <div class="container">
        <h2>공식 안내</h2>
        <p style="text-align:center;">
            {% for line in region.official_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}
        </p>
        <p style="text-align:center;margin-top:1rem;">
            👉 <a href="{{ region.naver_blog }}" target="_blank">네이버 블로그 바로가기</a><br>
            👉 <a href="{{ region.naver_place }}" target="_blank">네이버 플레이스에서 {{ region.name }} 보기</a>
        </p>
    </div>
</section>

<footer>
    <div class="container">
        <p><strong>{{ region.name }}</strong></p>
        {% if region.owner_name %}
        <p>대표 {{ region.owner_name }}</p>
        {% endif %}
        <p>{{ region.address }}</p>
        <p>{% for p in region.phones %}{{ p.label }} {{ p.number }}{% if not loop.last %} | {% endif %}{% endfor %}</p>
        {# 직업소개사업 등록번호 — 간판 사진 안에만 있어서 글자로는 어디에도 없었다.
           사업소 단위로 받는 번호라 지역마다 자기 것을 쓴다. #}
        {% if region.license_number %}
        <p style="opacity:.85;">직업소개사업 등록번호 {{ region.license_number }}</p>
        {% endif %}
        <p style="opacity:.8;margin-top:.5rem;">© {{ site.copyright_year }} {{ region.name }}</p>
    </div>
</footer>

<div class="floating-buttons">
    <a href="tel:{{ region.phones[0].number }}" class="floating-btn phone">📞</a>
    <a href="{{ region.kakao_open_chat }}" class="floating-btn kakao" target="_blank">💬</a>
</div>

<nav class="bottom-bar">
    <a href="tel:{{ region.phones[0].number }}" class="bar-call">📞 전화상담</a>
    <a href="{{ region.kakao_open_chat }}" class="bar-kakao" target="_blank">💬 카톡문의</a>
    <a href="{{ region.apply_links.employer }}" class="bar-apply" target="_blank">🏢 인력요청</a>
</nav>

</body>
</html>
