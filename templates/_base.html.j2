{#
  전 지역·전 페이지 공통 껍데기.

  여기를 고치면 모든 지역의 모든 페이지가 같이 고쳐진다.
  페이지별로 다른 것만 아래 블록으로 넘긴다:

      seo_title / seo_description / seo_keywords / og_title / og_description
      extra_css   <- **style 태그 없이 CSS 규칙만.** 여기는 이미 <style> 안이다.
      content

  ⚠️ 자식 템플릿에서 블록 바깥에 쓴 것은 렌더링되지 않는다. 전부 블록 안에 넣을 것.
#}<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block seo_title %}{{ region.seo.title }}{% endblock %}</title>

    <!-- SEO 기본 -->
    <meta name="description" content="{% block seo_description %}{{ region.seo.description }}{% endblock %}">
    <meta name="keywords" content="{% block seo_keywords %}{{ region.seo.keywords }}{% endblock %}">
    <meta name="author" content="{{ region.name }}">
    <meta name="robots" content="index, follow">

    <!-- 네이버 / 구글 -->
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">

    <!-- 아이콘 -->
    <link rel="icon" href="{{ asset('/favicon.ico') }}" sizes="any">
    <link rel="apple-touch-icon" href="{{ asset('/apple-touch-icon.png') }}">

    <!-- Open Graph — 카톡으로 링크를 보냈을 때 뜨는 카드 -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="{% block og_title %}{{ region.seo.og_title }}{% endblock %}">
    <meta property="og:description" content="{% block og_description %}{{ region.seo.og_description }}{% endblock %}">
    <meta property="og:url" content="{{ page_url }}">
    <meta property="og:site_name" content="{{ site.brand }}">
    {% if region.og_image %}
    <meta property="og:image" content="{{ ascii_base }}{{ region.og_image }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    {% endif %}

    <link rel="canonical" href="{{ page_url }}">

    <script type="application/ld+json">
{{ jsonld | safe }}
    </script>

    {% if site.ga_measurement_id %}
    <!-- Google 애널리틱스 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga_measurement_id }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', {{ site.ga_measurement_id | tojson }});
    </script>
    {% endif %}

    <!-- 본문 글꼴 — Pretendard. 한글 굵기 표현이 맑은 고딕보다 훨씬 또렷하다.
         dynamic-subset 이라 그 페이지에 실제로 쓰인 글자만 내려받는다(가볍다).
         못 받아오면 아래 font-family 의 시스템 글꼴로 자연스럽게 내려간다. -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="stylesheet" as="style" crossorigin
          href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">

    <style>
        /* 색·모양 한 벌 — 값을 여기서만 바꾸면 전 페이지가 같이 바뀐다.
           색을 규칙 안에 직접 적어 넣지 말 것. */
        :root {
            --navy: #1e3c72;
            --navy-deep: #17305c;
            --amber: #f5a623;
            --green: #17a34a;
            --ink: #22272f;
            --ink-soft: #5b6472;
            --line: #e7ebf2;
            --tint: #f6f8fc;
            --radius: 14px;
            --shadow: 0 2px 10px rgba(17,24,39,.06);
            --shadow-up: 0 10px 26px rgba(17,24,39,.12);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        /* word-break: keep-all — 한글은 이게 없으면 단어 한가운데서 줄이 끊긴다
           ("연천군"의 '군'만 다음 줄로 넘어가는 식). 읽는 속도가 눈에 띄게 달라진다. */
        body {
            font-family: 'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont,
                         system-ui, 'Malgun Gothic', sans-serif;
            line-height: 1.65;
            color: var(--ink);
            word-break: keep-all;
            -webkit-font-smoothing: antialiased;
            background: #fff;
        }

        header {
            background: linear-gradient(160deg, var(--navy) 0%, var(--navy-deep) 100%);
            color: #fff;
            padding: 2.2rem 0 2.6rem;
            text-align: center;
        }

        /* 간판 사진 — 사업자의 실물 증거라 빼지 않는다. 다만 액자처럼 두어
           "현수막을 그대로 붙인" 인상은 덜어낸다. */
        header img { border-radius: 12px; box-shadow: 0 6px 20px rgba(0,0,0,.25); }

        header h1 { font-size: 2.1rem; letter-spacing: -.02em; margin-bottom: .45rem; }
        header p { font-size: 1.05rem; opacity: .92; }

        .container { max-width: 1120px; margin: 0 auto; padding: 0 20px; }

        /* 상담 안내 — 노란 박스 대신 흰 카드에 앰버 한 줄 */
        .emergency-contact {
            background: #fff;
            border: 1px solid var(--line);
            border-top: 4px solid var(--amber);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 1.8rem 1.4rem;
            margin: 2.2rem 0;
            text-align: center;
        }

        .phone-numbers { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }

        .phone-number {
            background: var(--tint);
            border: 1px solid var(--line);
            padding: .9rem 1.6rem;
            border-radius: 12px;
            min-width: 190px;
        }

        .phone-number strong { color: var(--ink-soft); font-size: .92rem; font-weight: 600; }

        .phone-number a {
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--navy);
            text-decoration: none;
            letter-spacing: -.01em;
        }

        section { padding: 3.2rem 0; }

        h2 {
            text-align: center;
            font-size: 1.65rem;
            letter-spacing: -.02em;
            margin-bottom: 1.8rem;
            color: var(--navy);
        }

        .service-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px,1fr));
            gap: 1.1rem;
        }

        .service-card {
            background: #fff;
            border: 1px solid var(--line);
            padding: 1.7rem 1.2rem;
            border-radius: var(--radius);
            text-align: center;
            box-shadow: var(--shadow);
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .service-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-up); }
        .service-card .icon { font-size: 1.9rem; line-height: 1; margin-bottom: .6rem; }
        .service-card h3 { font-size: 1.05rem; color: var(--navy); margin-bottom: .3rem; }
        .service-card p { color: var(--ink-soft); font-size: .94rem; }

        footer {
            background: var(--navy-deep);
            color: #fff;
            text-align: center;
            padding: 2.4rem 0;
            font-size: .95rem;
            line-height: 1.9;
        }

        footer a { color: #ffd98a; }

        .floating-buttons {
            position: fixed;
            bottom: 25px;
            right: 25px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            z-index: 1000;
        }

        .floating-btn {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.7rem;
            color: white;
            text-decoration: none;
            box-shadow: 0 6px 16px rgba(0,0,0,.22);
            transition: transform .2s ease;
        }

        .floating-btn:hover { transform: scale(1.08); }

        .phone { background: var(--green); }
        .kakao { background: #FEE500; color: #3C1E1E; }

        /* ── 상단 바 (홈이 아닌 페이지) ───────────────────────── */
        .topbar {
            background: var(--navy-deep);
            color: #fff;
            padding: .9rem 0;
        }

        .topbar .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .topbar a { color: #fff; text-decoration: none; }
        .topbar .brand { font-size: 1.15rem; font-weight: bold; }
        .topbar .home-link { font-size: .95rem; opacity: .9; }

        /* ── 갈림길 ──────────────────────────────────────────
           소장과 인부는 서로 다른 것을 찾으러 온다. 첫 화면에서 갈라준다. */
        .fork { padding: 2.5rem 0 1rem; }

        .fork-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.25rem;
        }

        .fork-card {
            display: block;
            border-radius: var(--radius);
            padding: 1.9rem 1.4rem;
            text-decoration: none;
            text-align: center;
            box-shadow: var(--shadow);
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .fork-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-up); }

        .fork-card .fork-icon { font-size: 2.4rem; display: block; margin-bottom: .6rem; }
        .fork-card .fork-title { font-size: 1.3rem; font-weight: bold; display: block; margin-bottom: .35rem; }
        .fork-card .fork-sub { font-size: .95rem; opacity: .92; display: block; }

        .fork-hire { background: linear-gradient(150deg, var(--navy) 0%, var(--navy-deep) 100%); color: #fff; }
        .fork-job { background: linear-gradient(150deg, var(--amber) 0%, #ffc561 100%); color: #3a2a05; }

        /* ── 큰 전화 버튼 ───────────────────────────────────── */
        .call-cta {
            display: block;
            background: var(--green);
            color: #fff;
            text-align: center;
            text-decoration: none;
            font-size: 1.35rem;
            font-weight: bold;
            padding: 1.1rem 1rem;
            border-radius: var(--radius);
            box-shadow: 0 6px 18px rgba(23,163,74,.30);
            margin: 0 auto 1rem;
            max-width: 520px;
        }

        .call-cta small { display: block; font-size: .85rem; font-weight: normal; opacity: .95; margin-top: .2rem; }

        /* ── 페이지 머리 ────────────────────────────────────── */
        .page-head {
            background: linear-gradient(160deg, var(--navy) 0%, var(--navy-deep) 100%);
            color: #fff;
            padding: 2.8rem 0;
            text-align: center;
        }

        .page-head h1 { font-size: 1.9rem; margin-bottom: .6rem; }
        .page-head p { font-size: 1.05rem; opacity: .95; }

        /* ── 안내 목록 · FAQ ────────────────────────────────── */
        .info-list { max-width: 760px; margin: 0 auto; list-style: none; }

        .info-list li {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 1.1rem 1.3rem;
            margin-bottom: .8rem;
            box-shadow: var(--shadow);
        }

        .info-list li strong { display: block; color: var(--navy); margin-bottom: .2rem; }

        .faq { max-width: 760px; margin: 0 auto; }

        .faq-item {
            border-bottom: 1px solid var(--line);
            padding: 1.1rem .3rem;
        }

        .faq-item:last-child { border-bottom: none; }
        .faq-q { font-weight: bold; color: var(--navy); margin-bottom: .35rem; }
        .faq-a { color: #555; }

        .note {
            max-width: 760px;
            margin: 1.2rem auto 0;
            text-align: center;
            color: var(--ink-soft);
            font-size: .93rem;
        }

        /* 본문 아래로 이어지는 링크 줄 — 좁은 화면에서는 한 줄씩 내려간다 */
        .sub-links {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: .6rem 2rem;
            margin-top: 1.5rem;
        }

        .sub-links a { color: var(--navy); font-weight: bold; text-decoration: none; }
        .sub-links a:hover { text-decoration: underline; }

        /* ── 하단 고정 바 (모바일) ──────────────────────────────
           동그란 플로팅 버튼이 본문과 신청 버튼 위에 겹쳐 있었다.
           바는 아무것도 안 가리고 항상 보인다. 데스크탑은 여백이 넉넉해 플로팅 유지. */
        .bottom-bar { display: none; }

        @media (max-width: 768px) {
            .floating-buttons { display: none; }

            .bottom-bar {
                display: flex;
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 1000;
                box-shadow: 0 -2px 12px rgba(0,0,0,.25);
            }

            .bottom-bar a {
                flex: 1;
                padding: 14px 4px;
                text-align: center;
                text-decoration: none;
                font-size: 15px;
                font-weight: bold;
                line-height: 1.3;
            }

            .bottom-bar .bar-call { background: var(--green); color: #fff; }
            .bottom-bar .bar-kakao { background: #FEE500; color: #3C1E1E; }
            .bottom-bar .bar-apply { background: var(--navy-deep); color: #fff; }

            body { padding-bottom: 56px; }

            /* 첫 화면 밀도 — 휴대폰에서는 간판·제목이 화면을 다 먹어 전화 버튼이
               아래로 밀린다. 제일 중요한 버튼이 스크롤 없이 보이도록 조인다. */
            header { padding: 1.4rem 0 1.8rem; }
            header h1 { font-size: 1.75rem; margin-bottom: .3rem; }
            header p { font-size: .97rem; }

            section { padding: 2.4rem 0; }
            h2 { font-size: 1.4rem; margin-bottom: 1.3rem; }

            .fork-grid { grid-template-columns: 1fr; gap: .8rem; }
            .fork-card { padding: 1.25rem 1rem; }
            .fork-card .fork-icon { font-size: 1.9rem; margin-bottom: .35rem; }
            .fork-card .fork-title { font-size: 1.2rem; }

            .emergency-contact { padding: 1.4rem 1rem; margin: 1.6rem 0; }
            .phone-number { min-width: 0; width: 100%; padding: .8rem 1rem; }

            .page-head { padding: 2rem 0; }
            .page-head h1 { font-size: 1.45rem; }
        }

{% block extra_css %}{% endblock %}
    </style>
</head>

<body itemscope itemtype="http://schema.org/LocalBusiness">

{% block content %}{% endblock %}

<footer>
    <div class="container">
        <p><strong>{{ region.name }}</strong></p>
        {% if region.owner_name %}
        <p>대표 {{ region.owner_name }}</p>
        {% endif %}
        <p>{{ region.address }}</p>
        <p>{% for p in region.phones %}{{ p.label }} {{ p.number }}{% if not loop.last %} | {% endif %}{% endfor %}</p>
        {# 직업소개사업 등록번호 — 사업소 단위로 받는 번호라 지역마다 자기 것을 쓴다. #}
        {% if region.license_number %}
        <p style="opacity:.85;">직업소개사업 등록번호 {{ region.license_number }}</p>
        {% endif %}
        <p style="margin-top:.8rem;">
            {% if page_key != 'home' %}<a href="{{ link('home') }}">홈으로</a> · {% endif %}
            <a href="{{ link('privacy') }}">개인정보 처리방침</a>
        </p>
        <p style="opacity:.8;margin-top:.5rem;">© {{ site.copyright_year }} {{ region.name }}</p>
    </div>
</footer>

<div class="floating-buttons">
    <a href="tel:{{ region.phones[0].number }}" class="floating-btn phone">📞</a>
    <a href="{{ region.kakao_open_chat }}" class="floating-btn kakao" target="_blank">💬</a>
</div>

<nav class="bottom-bar">
    <a href="tel:{{ region.phones[0].number }}" class="bar-call">📞 전화상담</a>
    <a href="{{ region.kakao_open_chat }}" class="bar-kakao" target="_blank">💬 카톡문의</a>
    {% if page_key == 'job' %}
    <a href="{{ region.apply_links.job_seeker }}" class="bar-apply" target="_blank">👤 구직신청</a>
    {% else %}
    <a href="{{ region.apply_links.employer }}" class="bar-apply" target="_blank">🏢 인력요청</a>
    {% endif %}
</nav>

{% if site.ga_measurement_id %}
<script>
(function () {
  // 전화·카톡·신청서 클릭을 센다.
  //
  // ⚠️ tel: 링크는 GA4의 '이탈 클릭'(향상된 측정)에 잡히지 않는다 — http(s) 링크가
  //    아니기 때문이다. 그런데 이 사이트에서 제일 중요한 행동이 바로 전화 걸기다.
  //    그래서 직접 보낸다. 이게 없으면 "전화가 몇 번 눌렸나"를 영영 알 수 없다.
  var HIRE_FORM = {{ region.apply_links.employer | tojson }};
  var JOB_FORM = {{ region.apply_links.job_seeker | tojson }};
  var PAGE = {{ page_key | tojson }};

  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest ? e.target.closest('a') : null;
    if (!a || typeof gtag !== 'function') return;
    var href = a.getAttribute('href') || '';

    if (href.indexOf('tel:') === 0) {
      gtag('event', 'call_click', { page_key: PAGE, phone_number: href.slice(4) });
    } else if (href.indexOf('open.kakao.com') > -1) {
      gtag('event', 'kakao_click', { page_key: PAGE });
    } else if (href === HIRE_FORM) {
      gtag('event', 'apply_click', { page_key: PAGE, apply_type: 'hire' });
    } else if (href === JOB_FORM) {
      gtag('event', 'apply_click', { page_key: PAGE, apply_type: 'job' });
    }
  }, true);
})();
</script>
{% endif %}

</body>
</html>
