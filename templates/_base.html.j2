{#
  전 지역·전 페이지 공통 껍데기.

  여기를 고치면 모든 지역의 모든 페이지가 같이 고쳐진다.
  페이지별로 다른 것만 아래 블록으로 넘긴다:

      seo_title / seo_description / seo_keywords / og_title / og_description
      extra_css   <- **style 태그 없이 CSS 규칙만.** 여기는 이미 <style> 안이다.
      content

  ⚠️ 자식 템플릿에서 블록 바깥에 쓴 것은 렌더링되지 않는다. 전부 블록 안에 넣을 것.
#}<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block seo_title %}{{ region.seo.title }}{% endblock %}</title>

    <!-- SEO 기본 -->
    <meta name="description" content="{% block seo_description %}{{ region.seo.description }}{% endblock %}">
    <meta name="keywords" content="{% block seo_keywords %}{{ region.seo.keywords }}{% endblock %}">
    <meta name="author" content="{{ region.name }}">
    <meta name="robots" content="index, follow">

    <!-- 네이버 / 구글 -->
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">

    <!-- 아이콘 -->
    <link rel="icon" href="{{ asset('/favicon.ico') }}" sizes="any">
    <link rel="apple-touch-icon" href="{{ asset('/apple-touch-icon.png') }}">

    <!-- Open Graph — 카톡으로 링크를 보냈을 때 뜨는 카드 -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="{% block og_title %}{{ region.seo.og_title }}{% endblock %}">
    <meta property="og:description" content="{% block og_description %}{{ region.seo.og_description }}{% endblock %}">
    <meta property="og:url" content="{{ page_url }}">
    <meta property="og:site_name" content="{{ site.brand }}">
    {% if region.og_image %}
    <meta property="og:image" content="{{ ascii_base }}{{ region.og_image }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    {% endif %}

    <link rel="canonical" href="{{ page_url }}">

    <script type="application/ld+json">
{{ jsonld | safe }}
    </script>

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        /* word-break: keep-all — 한글은 이게 없으면 단어 한가운데서 줄이 끊긴다
           ("연천군"의 '군'만 다음 줄로 넘어가는 식). 읽는 속도가 눈에 띄게 달라진다. */
        body {
            font-family: 'Malgun Gothic', sans-serif;
            line-height: 1.6;
            color: #333;
            word-break: keep-all;
        }

        header {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            padding: 2rem 0;
            text-align: center;
        }

        header h1 { font-size: 2.5rem; margin-bottom: .5rem; }
        header p { font-size: 1.1rem; opacity: .95; }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

        .emergency-contact {
            background: #fff3cd;
            border-left: 5px solid #ffc107;
            padding: 1.5rem;
            margin: 2rem 0;
            text-align: center;
        }

        .phone-numbers {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .phone-number {
            background: white;
            padding: 1rem 2rem;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,.1);
        }

        .phone-number a {
            font-size: 1.4rem;
            font-weight: bold;
            color: #1e3c72;
            text-decoration: none;
        }

        section { padding: 3rem 0; }
        h2 { text-align: center; font-size: 2rem; margin-bottom: 2rem; color: #1e3c72; }

        .service-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px,1fr));
            gap: 2rem;
        }

        .service-card {
            background: #fff;
            padding: 2rem;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0 3px 10px rgba(0,0,0,.1);
        }

        footer {
            background: #1e3c72;
            color: white;
            text-align: center;
            padding: 2rem 0;
        }

        footer a { color: #ffd98a; }

        .floating-buttons {
            position: fixed;
            bottom: 25px;
            right: 25px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            z-index: 1000;
        }

        .floating-btn {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: white;
            text-decoration: none;
            box-shadow: 0 4px 10px rgba(0,0,0,.3);
            transition: transform 0.3s ease;
        }

        .floating-btn:hover { transform: scale(1.1); }

        .phone { background: #28a745; }
        .kakao { background: #FEE500; color: #3C1E1E; }

        /* ── 상단 바 (홈이 아닌 페이지) ───────────────────────── */
        .topbar {
            background: #1e3c72;
            color: #fff;
            padding: .9rem 0;
        }

        .topbar .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .topbar a { color: #fff; text-decoration: none; }
        .topbar .brand { font-size: 1.15rem; font-weight: bold; }
        .topbar .home-link { font-size: .95rem; opacity: .9; }

        /* ── 갈림길 ──────────────────────────────────────────
           소장과 인부는 서로 다른 것을 찾으러 온다. 첫 화면에서 갈라준다. */
        .fork { padding: 2.5rem 0 1rem; }

        .fork-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.25rem;
        }

        .fork-card {
            display: block;
            border-radius: 14px;
            padding: 1.8rem 1.4rem;
            text-decoration: none;
            text-align: center;
            box-shadow: 0 6px 18px rgba(0,0,0,.12);
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .fork-card:hover { transform: translateY(-4px); box-shadow: 0 10px 24px rgba(0,0,0,.18); }

        .fork-card .fork-icon { font-size: 2.4rem; display: block; margin-bottom: .6rem; }
        .fork-card .fork-title { font-size: 1.3rem; font-weight: bold; display: block; margin-bottom: .35rem; }
        .fork-card .fork-sub { font-size: .95rem; opacity: .92; display: block; }

        .fork-hire { background: linear-gradient(135deg, #1B3A6B 0%, #2a5298 100%); color: #fff; }
        .fork-job { background: linear-gradient(135deg, #F5A623 0%, #f7b955 100%); color: #3a2a05; }

        /* ── 큰 전화 버튼 ───────────────────────────────────── */
        .call-cta {
            display: block;
            background: #28a745;
            color: #fff;
            text-align: center;
            text-decoration: none;
            font-size: 1.35rem;
            font-weight: bold;
            padding: 1.1rem 1rem;
            border-radius: 12px;
            box-shadow: 0 5px 14px rgba(40,167,69,.35);
            margin: 0 auto 1rem;
            max-width: 520px;
        }

        .call-cta small { display: block; font-size: .85rem; font-weight: normal; opacity: .95; margin-top: .2rem; }

        /* ── 페이지 머리 ────────────────────────────────────── */
        .page-head {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: #fff;
            padding: 2.6rem 0;
            text-align: center;
        }

        .page-head h1 { font-size: 1.9rem; margin-bottom: .6rem; }
        .page-head p { font-size: 1.05rem; opacity: .95; }

        /* ── 안내 목록 · FAQ ────────────────────────────────── */
        .info-list { max-width: 760px; margin: 0 auto; list-style: none; }

        .info-list li {
            background: #f9fafc;
            border-radius: 12px;
            padding: 1.1rem 1.3rem;
            margin-bottom: .8rem;
            box-shadow: 0 4px 14px rgba(0,0,0,.05);
        }

        .info-list li strong { display: block; color: #1e3c72; margin-bottom: .2rem; }

        .faq { max-width: 760px; margin: 0 auto; }

        .faq-item {
            border-bottom: 1px solid #e5e8ee;
            padding: 1.1rem .3rem;
        }

        .faq-item:last-child { border-bottom: none; }
        .faq-q { font-weight: bold; color: #1e3c72; margin-bottom: .35rem; }
        .faq-a { color: #555; }

        .note {
            max-width: 760px;
            margin: 1.2rem auto 0;
            text-align: center;
            color: #777;
            font-size: .92rem;
        }

        /* ── 하단 고정 바 (모바일) ──────────────────────────────
           동그란 플로팅 버튼이 본문과 신청 버튼 위에 겹쳐 있었다.
           바는 아무것도 안 가리고 항상 보인다. 데스크탑은 여백이 넉넉해 플로팅 유지. */
        .bottom-bar { display: none; }

        @media (max-width: 768px) {
            .floating-buttons { display: none; }

            .bottom-bar {
                display: flex;
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 1000;
                box-shadow: 0 -2px 12px rgba(0,0,0,.25);
            }

            .bottom-bar a {
                flex: 1;
                padding: 14px 4px;
                text-align: center;
                text-decoration: none;
                font-size: 15px;
                font-weight: bold;
                line-height: 1.3;
            }

            .bottom-bar .bar-call { background: #28a745; color: #fff; }
            .bottom-bar .bar-kakao { background: #FEE500; color: #3C1E1E; }
            .bottom-bar .bar-apply { background: #1e3c72; color: #fff; }

            body { padding-bottom: 56px; }

            .fork-grid { grid-template-columns: 1fr; }
            header h1 { font-size: 2rem; }
            .page-head h1 { font-size: 1.5rem; }
            h2 { font-size: 1.6rem; }
        }

{% block extra_css %}{% endblock %}
    </style>
</head>

<body itemscope itemtype="http://schema.org/LocalBusiness">

{% block content %}{% endblock %}

<footer>
    <div class="container">
        <p><strong>{{ region.name }}</strong></p>
        {% if region.owner_name %}
        <p>대표 {{ region.owner_name }}</p>
        {% endif %}
        <p>{{ region.address }}</p>
        <p>{% for p in region.phones %}{{ p.label }} {{ p.number }}{% if not loop.last %} | {% endif %}{% endfor %}</p>
        {# 직업소개사업 등록번호 — 사업소 단위로 받는 번호라 지역마다 자기 것을 쓴다. #}
        {% if region.license_number %}
        <p style="opacity:.85;">직업소개사업 등록번호 {{ region.license_number }}</p>
        {% endif %}
        {% if page_key != 'home' %}
        <p style="margin-top:.8rem;"><a href="{{ link('home') }}">홈으로</a></p>
        {% endif %}
        <p style="opacity:.8;margin-top:.5rem;">© {{ site.copyright_year }} {{ region.name }}</p>
    </div>
</footer>

<div class="floating-buttons">
    <a href="tel:{{ region.phones[0].number }}" class="floating-btn phone">📞</a>
    <a href="{{ region.kakao_open_chat }}" class="floating-btn kakao" target="_blank">💬</a>
</div>

<nav class="bottom-bar">
    <a href="tel:{{ region.phones[0].number }}" class="bar-call">📞 전화상담</a>
    <a href="{{ region.kakao_open_chat }}" class="bar-kakao" target="_blank">💬 카톡문의</a>
    {% if page_key == 'job' %}
    <a href="{{ region.apply_links.job_seeker }}" class="bar-apply" target="_blank">👤 구직신청</a>
    {% else %}
    <a href="{{ region.apply_links.employer }}" class="bar-apply" target="_blank">🏢 인력요청</a>
    {% endif %}
</nav>

</body>
</html>
